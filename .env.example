# Optional environment configuration (export these in the shell before launch).
SMARTMEM_DB_PATH=data/smartmem.db
SMARTMEM_RECYCLE_BIN=~/.smartmem_recycle
OLLAMA_BASE=http://127.0.0.1:11434
OLLAMA_TIMEOUT=60
OLLAMA_AUTOSTART=true
MEMORA_DOCUMENT_MAX_CHARS=100000
MEMORA_CHUNK_SIZE=1200
MEMORA_CHUNK_OVERLAP=160
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:8000
LOG_LEVEL=INFO
